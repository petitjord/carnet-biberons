rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Biberons : accès par code famille secret (au moins 16 caractères).
    // Le champ facultatif « by » (prénom de la personne qui a donné le biberon) est accepté.
    match /families/{code}/feeds/{feedId} {
      allow read, delete: if code.size() >= 16;
      allow create, update: if code.size() >= 16
        && request.resource.data.keys().hasOnly(['ts', 'ml', 'by'])
        && request.resource.data.keys().hasAll(['ts', 'ml'])
        && request.resource.data.ts is number
        && request.resource.data.ml is number
        && request.resource.data.ml >= 1 && request.resource.data.ml <= 1000
        && (!('by' in request.resource.data)
            || (request.resource.data.by is string && request.resource.data.by.size() <= 20));
    }

    // Santé et couches : Doliprane, température, caca.
    match /families/{code}/events/{eventId} {
      allow read, delete: if code.size() >= 16;
      allow create, update: if code.size() >= 16
        && request.resource.data.keys().hasOnly(['ts', 'kind', 'temp', 'by'])
        && request.resource.data.keys().hasAll(['ts', 'kind'])
        && request.resource.data.ts is number
        && request.resource.data.kind in ['dose', 'temp', 'poop']
        && (!('temp' in request.resource.data)
            || (request.resource.data.temp is number && request.resource.data.temp >= 34 && request.resource.data.temp <= 43))
        && (!('by' in request.resource.data)
            || (request.resource.data.by is string && request.resource.data.by.size() <= 20));
    }

    // Fiche du bébé
    match /families/{code}/baby/profile {
      allow read: if code.size() >= 16;
      allow create, update: if code.size() >= 16
        && request.resource.data.keys().hasOnly(['name', 'birthDate'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.birthDate is string && request.resource.data.birthDate.size() == 10;
      allow delete: if false;
    }
  }
}
